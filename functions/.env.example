# Non-secret mail settings. Copy to functions/.env (gitignored) before deploy.
# The SMTP password is a secret, not an env value:
#   npx -y firebase-tools@latest functions:secrets:set SMTP_PASS
# Set RECAPTCHA_SECRET to "off" until a v3 key pair exists:
#   npx -y firebase-tools@latest functions:secrets:set RECAPTCHA_SECRET
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER and FROM_EMAIL are
# the mailbox, and SMTP_PASS is a Google app password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aaronceasterday@gmail.com
NOTIFY_TO=aaronceasterday@gmail.com
FROM_EMAIL=aaronceasterday@gmail.com
FROM_NAME=Diabolic Media
SITE_URL=https://diabolicsocial.com
SITE_PHONE=(240) 625 2480
SITE_PHONE_HREF=+12406252480
TIMEZONE=America/New_York
SEND_AUTOREPLY=false
RECAPTCHA_MIN_SCORE=0.5
