---
import texture from '../../assets/home/texture.jpg';

interface Props {
  bleed?: 'hero' | 'band' | 'footer';
}

const { bleed = 'band' } = Astro.props;
---

<div class="pointer-events-none absolute inset-0" aria-hidden="true">
  <div class="bg-night absolute inset-0"></div>
  <img
    src={texture.src}
    alt=""
    width={texture.width}
    height={texture.height}
    class:list={[
      'absolute max-w-none',
      bleed === 'hero' && 'inset-y-0 left-[-11.8%] h-full w-[123.6%] object-cover',
      bleed === 'band' && 'inset-y-0 left-[-4.98%] h-full w-[109.96%] object-cover',
      bleed === 'footer' && 'top-[-139.12%] left-0 h-[324.39%] w-full object-cover',
    ]}
  />
  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,rgba(17,11,8,0.24)_0%,rgba(17,11,8,0)_31%,rgba(17,11,8,0)_68%,rgba(17,11,8,0.25)_100%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_42%,rgba(10,7,5,0.18)_100%)]"
  >
  </div>
  <div class="absolute inset-0 bg-[linear-gradient(119deg,rgba(71,47,28,0.08),rgba(10,8,7,0.11))]">
  </div>
</div>
