---
import logo from '../../assets/home/logo.png';

interface Props {
  class?: string;
  /** Knock out the plate so a textured ground shows through. Off when the bar matches the plate. */
  blend?: boolean;
}

const { class: className, blend = true } = Astro.props;
---

<span
  class:list={[
    'relative block h-[34px] w-[192px] overflow-hidden sm:h-[44px] sm:w-[248px]',
    className,
  ]}
>
  <img
    src={logo.src}
    alt=""
    width={logo.width}
    height={logo.height}
    class:list={[
      'absolute top-[-197.8%] left-[-27.6%] h-[498%] w-[154.7%] max-w-none',
      blend && 'mix-blend-screen',
    ]}
  />
</span>
