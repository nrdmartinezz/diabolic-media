---
import { Image } from 'astro:assets';
import BrandButton from '../brand/BrandButton.astro';
import ParchmentSection from './ParchmentSection.astro';
import aboutArt from '../../assets/home/about-engraving.jpg';
---

<ParchmentSection id="about" class="lg:pt-28">
  <div
    class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(260px,390px)] lg:gap-16"
  >
    <div class="flex flex-col gap-6">
      <div class="flex max-w-[710px] flex-col gap-6">
        <p
          class="font-heading text-brand-700 text-[11.5px] leading-none font-bold tracking-[0.14em] uppercase"
        >
          About the agency
        </p>
        <h2
          class="font-heading text-[clamp(2.75rem,7vw,6.3rem)] leading-[0.71] font-medium tracking-[-0.065em]"
        >
          Trend-Aware.
          <br />
          <span class="text-accent-600 italic">Visually </span>
          <span class="text-burgundy font-semibold">Distinct.</span>
        </h2>
      </div>

      <div class="grid max-w-[710px] gap-8 pt-2 lg:grid-cols-2 lg:items-start">
        <p class="text-bark text-[18.9px] leading-[1.55] font-medium">
          <span
            class="font-heading text-burgundy float-left mt-1 mr-3 text-[5.8rem] leading-[0.7] font-medium"
            >D</span
          >iabolic Media helps brands show up consistently and recognizably on social media.
        </p>
        <p class="text-bark text-[18.9px] leading-[1.55] font-medium">
          We follow the trends that matter, then shape them around your point of view. The result
          feels current without looking like everyone else.
        </p>
      </div>

      <BrandButton href="/#contact" class="mt-2">Get in Touch</BrandButton>
    </div>

    <figure
      class="relative mx-auto w-full max-w-[390px] border border-[rgba(89,70,37,0.62)] bg-[rgba(247,242,224,0.45)] p-[13px] shadow-[10px_12px_0_rgba(84,59,33,0.1),inset_0_0_0_5px_rgba(109,90,50,0.08)]"
    >
      <span class="text-burgundy absolute top-1 left-1.5 text-[11px]" aria-hidden="true">✦</span>
      <span class="text-burgundy absolute right-1.5 bottom-1 text-[11px]" aria-hidden="true">✦</span
      >
      <div class="border border-[rgba(52,41,25,0.48)]">
        <Image
          src={aboutArt}
          alt="Antique engraving of a winged figure in red robes"
          widths={[390, 780]}
          sizes="(min-width: 1024px) 390px, 90vw"
          class="aspect-3/4 h-auto w-full object-cover"
        />
      </div>
    </figure>
  </div>
</ParchmentSection>
