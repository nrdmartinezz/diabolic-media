---
/**
 * Site header. The bar matches the wordmark plate so the logo has no visible box.
 */
import Logo from '../brand/Logo.astro';
import BrandButton from '../brand/BrandButton.astro';
import MobileNav from './MobileNav.astro';
import { navigation } from '../../config/navigation';

export type HeaderSticky = 'static' | 'sticky' | 'shrink' | 'hide-on-scroll';

interface Props {
  sticky?: HeaderSticky;
  overlay?: boolean;
}

const { sticky = 'sticky', overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;

const linkClass =
  'font-heading text-[10.2px] leading-none tracking-[0.16em] text-cream/75 uppercase no-underline transition-colors hover:text-cream';
---

<header
  data-sticky={overlay ? 'overlay' : sticky}
  class:list={[
    'z-50 w-full border-b border-[rgba(212,190,145,0.42)] bg-[#181818]',
    overlay ? 'fixed inset-x-0 top-0' : 'sticky top-0',
  ]}
>
  <div
    class="mx-auto flex h-[72px] w-full max-w-[1200px] items-center gap-4 px-5 lg:h-[102px] xl:px-0"
  >
    <a href="/" class="shrink-0 no-underline" aria-label="Diabolic Media home">
      <Logo blend={false} />
    </a>

    <nav aria-label="Primary" class="hidden flex-1 justify-center lg:flex">
      <ul class="flex items-center gap-10">
        {
          navigation.primary.map((item) => (
            <li>
              <a href={item.href ?? '/'} class={linkClass}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      navigation.cta && (
        <div class="flex items-center max-lg:hidden">
          <BrandButton href={navigation.cta.href} variant="gradient" width="auto">
            {navigation.cta.label}
          </BrandButton>
        </div>
      )
    }

    <MobileNav currentPath={currentPath} />
  </div>
</header>

<style>
  header[data-sticky='overlay'] {
    transition: background-color 150ms ease;
  }

  header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    header[data-sticky='overlay'] {
      transition: none;
    }

    header[data-hidden='true'] {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('header[data-sticky]');

  if (header) {
    const mode = header.dataset.sticky;

    if (mode === 'overlay' || mode === 'shrink' || mode === 'hide-on-scroll') {
      let lastY = window.scrollY;
      let ticking = false;

      const update = () => {
        const y = window.scrollY;
        header.dataset.scrolled = String(y > 8);

        if (mode === 'hide-on-scroll') {
          const navOpen =
            document.querySelector('#nav-toggle')?.getAttribute('aria-expanded') === 'true' ||
            document.querySelector('.mega-item[data-open="true"]') !== null;
          header.dataset.hidden = String(!navOpen && y > lastY && y > 120);
        }

        lastY = y;
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );

      update();
    }
  }
</script>
